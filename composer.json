{
    "name": "timlytle/battlesnake-php",
    "description": "A framework-less PHP implementation of Battlesnake using PSR-7, PSR-15, and PSR-17",
    "type": "project",
    "require": {
        "php": "^8.4",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-message": "^1.0",
        "laminas/laminas-diactoros": "^3.5",
        "league/openapi-psr7-validator": "^0.22.0",
        "doctrine/dbal": "^4.2",
        "doctrine/orm": "^3.3",
        "crell/serde": "^1.3",
        "ramsey/uuid": "^4.7",
        "psr/container": "^2.0",
        "php-di/php-di": "^7.0",
        "crell/tukio": "^2.0",
        "psr/event-dispatcher": "^1.0",
        "symfony/cache": "^7.2"

    },
    "autoload": {
        "psr-4": {
            "BattleSnake\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BattleSnake\\Tests\\": "test/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "squizlabs/php_codesniffer": "^3.6",
        "phpstan/phpstan": "^1.0",
        "phpstan/phpstan-phpunit": "^1.0",
        "phpspec/prophecy": "^1.22",
        "phpspec/prophecy-phpunit": "^2.3",
        "behat/behat": "^3.21"
    }
}
