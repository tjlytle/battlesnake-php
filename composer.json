{
    "name": "timlytle/battlesnake-php",
    "description": "A framework-less PHP implementation of Battlesnake using PSR-7, PSR-15, and PSR-17",
    "type": "project",
    "require": {
        "php": "^8.4",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/http-message": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "BattleSnake\\": "src/"
        }
    }
} 